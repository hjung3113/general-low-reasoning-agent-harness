#!/bin/sh
# HARNESS:scope-check-begin
# Installed by `python3 scripts/harness.py install --pre-commit`.
# See docs/protocol-spec.md#scope-enforcement.
#
# Resolve repo root robustly — git invokes hooks from arbitrary cwd
# subtrees (interactive rebase, partial commits, etc.).
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "harness pre-commit hook: not inside a git repo; skipping scope check (non-fatal)" >&2
    exit 0
}
# T1-1-C2: locate the harness CLI in installed targets, not just the
# source repo. Prefer a `harness` on PATH, then fall back to the
# source-tree layout. Hard-fail when neither is reachable so silent
# skips can never mask the gate; an explicit opt-out env var preserves
# the legacy non-fatal-warning behavior for environments that cannot
# install the harness yet.
HARNESS_CMD=""
if command -v harness >/dev/null 2>&1; then
    HARNESS_CMD="harness"
elif [ -f "$REPO_ROOT/scripts/harness.py" ]; then
    # `python3 scripts/harness.py check --worktree` (source-tree layout).
    HARNESS_CMD="python3 $REPO_ROOT/scripts/harness.py"
fi
if [ -z "$HARNESS_CMD" ]; then
    if [ "${HARNESS_HOOK_ALLOW_SKIP:-0}" = "1" ]; then
        echo "harness pre-commit hook: harness CLI not found; HARNESS_HOOK_ALLOW_SKIP=1 — skipping (non-fatal)" >&2
        exit 0
    fi
    echo "harness pre-commit hook: harness CLI not found — scope enforcement REQUIRED but unavailable. Install harness or remove pre-commit hook. Set HARNESS_HOOK_ALLOW_SKIP=1 to opt into silent-skip." >&2
    exit 1
fi
if [ ! -f "$REPO_ROOT/.scratch/phase-state.json" ]; then
    if [ "${HARNESS_HOOK_ALLOW_SKIP:-0}" = "1" ]; then
        echo "harness pre-commit hook: .scratch/phase-state.json missing; HARNESS_HOOK_ALLOW_SKIP=1 — skipping (non-fatal)" >&2
        exit 0
    fi
    echo "harness pre-commit hook: .scratch/phase-state.json missing — scope enforcement REQUIRED but unavailable. Run 'harness phase set' or set HARNESS_HOOK_ALLOW_SKIP=1." >&2
    exit 1
fi
(cd "$REPO_ROOT" && $HARNESS_CMD check --worktree) || exit $?
# HARNESS:scope-check-end
