#!/bin/sh
set -eu

branch="$(git branch --show-current)"

if [ "$branch" != "main" ]; then
  exit 0
fi

if [ -f "$(git rev-parse --git-path MERGE_HEAD)" ]; then
  merge_head="$(cat "$(git rev-parse --git-path MERGE_HEAD)")"
  allowed_source=""

  for ref in refs/heads/develop refs/remotes/origin/develop refs/heads/hotfix/* refs/remotes/origin/hotfix/*
  do
    for candidate in $(git for-each-ref --format='%(objectname)' "$ref")
    do
      if [ "$merge_head" = "$candidate" ]; then
        allowed_source="$ref"
        break 2
      fi
    done
  done

  if [ -n "$allowed_source" ]; then
    exit 0
  fi

  cat >&2 <<'EOF'
Blocked: merge commits on main are only allowed from develop or hotfix/*.

Allowed:
  git merge --no-ff develop
  git merge --no-ff hotfix/<name>
EOF
  exit 1
fi

changed_paths="$(git diff --cached --name-only --diff-filter=ACMRT)"

if [ -z "$changed_paths" ]; then
  exit 0
fi

non_readme_paths="$(printf '%s\n' "$changed_paths" | awk '$0 != "README.md"')"

if [ -n "$non_readme_paths" ]; then
  cat >&2 <<'EOF'
Blocked: commits on main are limited to README.md-only updates.

Create a feature branch for code, harness, docs, and workflow changes:
  git switch -c <branch-name>
EOF
  printf '\nNon-README staged paths:\n%s\n' "$non_readme_paths" >&2
  exit 1
fi
